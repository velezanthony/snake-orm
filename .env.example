# One config for the whole repo: the ORM and the three framework demos share it.
# Copy this to `.env` (yours, git-ignored) and `.env.example` (committed, with
# DEMO_SECRET_KEY left as change-me). The tool cannot write `.env*` files, hence
# this `.txt`.
#
# With no `.env`: the ORM uses the devcontainer defaults and the demos run on SQLite.


# --- The switch -------------------------------------------------------------
# Engine for the three demos at once: sqlite | postgres | mysql.
# Validated on boot: a typo does not fall back to SQLite in silence.
DB_BACKEND=postgres


# --- Engine: PostgreSQL -----------------------------------------------------
# `docker compose up -d db`
#
# `DB_*` is the ORM's own public contract (`snakeorm/core/config.py`, read by the
# CLI), so it is NOT renamed to `DB_*_POSTGRES`: that would break the `.env` of
# anyone who installed the library.
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=snakeorm_pass
DB_NAME=snakeorm_db

# Second named connection (multi-DB). Same container, so the SAME published port.
#   docker compose exec db psql -U postgres -c "CREATE DATABASE snakeorm_analytics"
SNAKEORM_DSN_ANALYTICS=host=127.0.0.1 port=5434 user=postgres password=snakeorm_pass dbname=snakeorm_analytics


# --- Engine: MySQL / MariaDB ------------------------------------------------
# `docker compose up -d mysql`
#
# NOT optional, however optional it looks: without `MYSQL_HOST` the three files in
# `src/test/integration/test_*mysql*.py` SKIP — 11 tests — and the suite still goes
# green. Same trap as the Postgres gate above, on the engine nobody wrote it down for.
#
# These names are the ones BOTH the ORM's e2e tests and the demos already read.
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=snakeorm_pass
MYSQL_DB=snakeorm_db


# --- Demos ------------------------------------------------------------------
# Debug orm
SNAKE_ORM_DEBUG=ssr,envelope,timing,sidecar,otel

# One database per framework, whatever the engine. Created automatically.
DJANGO_DB_NAME=django_demo
FLASK_DB_NAME=flask_demo
FASTAPI_DB_NAME=fastapi_demo

# Signs the demos' login cookies. CHANGE IT for any real deployment.
DEMO_SECRET_KEY=change-me

# Debug orm calls on jaeger
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318

# Where the `otel` channel POSTS its spans, and what names the service in Jaeger's dropdown. These
# are OpenTelemetry's OWN variable names, not SnakeORM's: anyone who has configured another exporter
# already has them set. Without them the spans go to http://localhost:4318/v1/traces and the service
# is called `snakeorm`, so this block only earns its place by naming the demo.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=snakeorm-demo
